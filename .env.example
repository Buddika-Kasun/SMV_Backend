# =============================================================
# SMV Holdings Backend - Environment Configuration
# Copy this file to .env and fill in your own values
# =============================================================

# ---- Runtime --------------------------------------------------
NODE_ENV=development
PORT=<server-port>

# ---- Database -------------------------------------------------
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

TZ=Asia/Colombo

# ---- JWT ------------------------------------------------------
# Access token (short-lived)
JWT_SECRET=<your-access-token-secret>
JWT_EXPIRES_IN=<e.g. 7d>

# Refresh token (separate signing key; rotate on every refresh)
JWT_REFRESH_SECRET=<your-refresh-token-secret>
JWT_REFRESH_EXPIRES_IN=<e.g. 30d>

# ---- SMS (Text.lk) --------------------------------------------
# Empty key disables live sending -> simulated SENT status
TEXT_LK_API_KEY=<your-textlk-api-key>
TEXT_LK_SENDER_ID=<your-sender-id>
TEXT_LK_URL=<sms-api-url>

# ---- CORS -----------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=<origin-1>,<origin-2>

# ---- File uploads (local fallback) ----------------------------
UPLOAD_DIR=<upload-directory>

# ---- Object storage (S3-compatible: R2 / MinIO / AWS S3) ------
# Files are uploaded by the client directly via presigned URLs.
# Only the object key is stored in PostgreSQL.
STORAGE_BUCKET_NAME=<bucket-name>
STORAGE_ACCESS_KEY=<access-key-id>
STORAGE_SECRET_KEY=<secret-access-key>
STORAGE_ENDPOINT=<storage-endpoint-url>
STORAGE_REGION=<storage-region>
STORAGE_PRESIGN_DURATION=<seconds>

RUN_SEED=<true|false>