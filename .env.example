# =============================================================
# SMV Holdings Backend - Environment Configuration
# Copy this file to .env and adjust for your environment
# =============================================================

# HTTP server port
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smv_holdings"

# JWT configuration (access token: 7-day validity)
JWT_SECRET="smv-holdings-super-secret-change-me-in-production"
JWT_EXPIRES_IN=7d

# Refresh token configuration (separate signing key; rotate on every refresh)
JWT_REFRESH_SECRET="smv-holdings-refresh-secret-change-me-in-production"
JWT_REFRESH_EXPIRES_IN=30d

# Text.lk SMS Gateway (empty key disables live sending -> simulated SENT)
TEXT_LK_API_KEY=""
TEXT_LK_SENDER_ID="SMVHoldings"
TEXT_LK_URL="https://api.textlk.com/sms/send"

# CORS origins allowed to reach this API (comma separated)
CORS_ORIGINS="http://localhost:5173"

# Passbook upload directory
UPLOAD_DIR="./uploads"

# Object storage bucket (S3-compatible - Cloudflare R2 / MinIO / AWS S3)
# File bytes are uploaded by the client directly to the bucket via presigned
# URLs; only the object key is stored in PostgreSQL.
STORAGE_BUCKET_NAME=your-bucket-name
STORAGE_ACCESS_KEY=your-access-key-id
STORAGE_SECRET_KEY=your-secret-access-key
STORAGE_ENDPOINT=https://<account>.storageapi.dev
STORAGE_REGION=auto

# Presigned URL lifetime in seconds (default 900 = 15 minutes)
STORAGE_PRESIGN_DURATION=900