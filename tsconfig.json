{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    // "moduleResolution": "node",
    "lib": ["ES2021"],
    "types": ["node"],
    "sourceMap": true,
    // "outDir": "dist",
    // "baseUrl": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "deploy"]
}